{
  "name": "veneer",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "tsc -b packages/server packages/tn3270 && npm run build -w @veneer/client",
    "typecheck": "tsc -b packages/server packages/tn3270 && tsc -p packages/client --noEmit",
    "test": "npm test --workspaces --if-present",
    "dev": "npm run dev -w @veneer/server",
    "start": "npm start -w @veneer/server",
    "cli": "npm run cli -w @veneer/tn5250 --",
    "demo": "npm run demo -w @veneer/server",
    "dev:client": "npm run dev -w @veneer/client",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "~5.9.0"
  }
}
